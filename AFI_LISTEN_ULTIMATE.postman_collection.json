{
	"info": {
		"_postman_id": "afi-listen-v1-ultimate-fixed",
		"name": "AFI-LISTEN API v1 PRO AUDIT",
		"description": "Collection d'audit complet simulant des scénarios réels avec capture dynamique d'IDs.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Setup & Auth",
			"item": [
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login Successful\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"adminToken\", jsonData.data.token);",
									"pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@afi.com\",\n    \"password\": \"fadeldev\"\n}",
							"options": {
								"raw": { "language": "json" }
							}
						},
						"url": "{{baseUrl}}/auth/login"
					}
				},
				{
					"name": "Capture Classes (ID)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.test(\"Classes fetched\", function () { pm.expect(jsonData.data.length).to.be.above(0); });",
									"pm.collectionVariables.set(\"testClassId\", jsonData.data[0].id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
						"method": "GET",
						"url": "{{baseUrl}}/classes"
					}
				},
				{
					"name": "Capture Modules (ID)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"testModId\", jsonData.data[0].id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
						"method": "GET",
						"url": "{{baseUrl}}/academic-modules"
					}
				},
				{
					"name": "Capture Professors (ID)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"testProfId\", jsonData.data[0].id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
						"method": "GET",
						"url": "{{baseUrl}}/professors"
					}
				}
			]
		},
		{
			"name": "2. Campaigns & Notifications",
			"item": [
				{
					"name": "Create Evaluation Campaign (Dynamic)",
					"event": [
						{
						"listen": "test",
						"script": { "exec": [ "pm.test(\"Campaign Created\", function () { pm.response.to.have.status(201); });" ], "type": "text/javascript" }
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Audit Campaign {{currentDate}}\",\n    \"description\": \"Test auto-notif\",\n    \"classId\": \"{{testClassId}}\",\n    \"moduleId\": \"{{testModId}}\",\n    \"professorId\": \"{{testProfId}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{baseUrl}}/evaluation-campaigns"
					}
				}
			]
		},
		{
			"name": "3. AI Automation",
			"item": [
				{
					"name": "Get AI Balancer Status",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
						"method": "GET",
						"url": "{{baseUrl}}/system/ai-status"
					}
				},
				{
					"name": "Create Report for Analysis",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"reportId\", jsonData.data.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Problème urgent\",\n    \"content\": \"La connexion internet ne fonctionne plus en salle 101.\",\n    \"type\": \"PROBLEM_MATERIAL\",\n    \"isAnonymous\": true\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{baseUrl}}/reports"
					}
				},
				{
					"name": "Retry / Force AI Analysis",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
						"method": "POST",
						"url": "{{baseUrl}}/reports/{{reportId}}/analyze"
					}
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": { "type": "text/javascript", "exec": [ "pm.collectionVariables.set(\"currentDate\", new Date().toISOString());" ] }
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.test(\"Standard Format Verified\", function () {",
					"    var jsonData = pm.response.json();",
					"    pm.expect(jsonData).to.have.property('success');",
					"    pm.expect(jsonData).to.have.property('data');",
					"});"
				]
			}
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
		{ "key": "adminToken", "value": "" },
		{ "key": "refreshToken", "value": "" },
		{ "key": "testClassId", "value": "" },
		{ "key": "testModId", "value": "" },
		{ "key": "testProfId", "value": "" },
		{ "key": "reportId", "value": "" },
		{ "key": "currentDate", "value": "" }
	]
}
