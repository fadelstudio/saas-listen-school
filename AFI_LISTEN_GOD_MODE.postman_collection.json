{
	"info": {
		"_postman_id": "afi-listen-god-mode-v2",
		"name": "AFI-LISTEN GOD MODE AUDIT",
		"description": "Scénario de test ABSOLU : Triple volume, CRUD exhaustif sur 100% des entités, Gestion ISO et Sécurité Multi-Rôles.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. SETUP & AUTH",
			"item": [
				{
					"name": "Login Admin",
					"event": [ { "listen": "test", "script": { "exec": [ "var jsonData = pm.response.json(); pm.collectionVariables.set(\"adminToken\", jsonData.data.token);" ], "type": "text/javascript" } } ],
					"request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"email\": \"admin@afi.com\", \"password\": \"fadeldev\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" }
				},
				{
					"name": "Capture Campus ID",
					"event": [ { "listen": "test", "script": { "exec": [ "pm.collectionVariables.set(\"realCId\", pm.response.json().data[0].id);" ], "type": "text/javascript" } } ],
					"request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/campuses" }
				}
			]
		},
		{
			"name": "2. CRUD REFERENTIELS (TRIPLE)",
			"item": [
				{
					"name": "Campuses",
					"item": [
						{ "name": "Create", "event": [ { "listen": "test", "script": { "exec": [ "pm.collectionVariables.set(\"tC\", pm.response.json().data.id);" ], "type": "text/javascript" } } ], "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "POST", "body": { "mode": "raw", "raw": "{\"name\": \"Campus Newman\", \"address\": \"Dakar\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/campuses" } },
						{ "name": "Update", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "PATCH", "body": { "mode": "raw", "raw": "{\"name\": \"Campus Updated\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/campuses/{{tC}}" } },
						{ "name": "Delete", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "DELETE", "url": "{{baseUrl}}/campuses/{{tC}}" } }
					]
				},
				{
					"name": "Levels",
					"item": [
						{ "name": "Create", "event": [ { "listen": "test", "script": { "exec": [ "pm.collectionVariables.set(\"tL\", pm.response.json().data.id);" ], "type": "text/javascript" } } ], "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "POST", "body": { "mode": "raw", "raw": "{\"name\": \"Level NEW {{currentDate}}\", \"order\": 1}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/levels" } },
						{ "name": "Update", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "PATCH", "body": { "mode": "raw", "raw": "{\"name\": \"Level UPD {{currentDate}}\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/levels/{{tL}}" } },
						{ "name": "Delete", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "DELETE", "url": "{{baseUrl}}/levels/{{tL}}" } }
					]
				}
			]
		},
		{
			"name": "3. ACADEMIC ENGINE",
			"item": [
				{
					"name": "Professors",
					"item": [
						{ "name": "Create", "event": [ { "listen": "test", "script": { "exec": [ "pm.collectionVariables.set(\"tP\", pm.response.json().data.id);" ], "type": "text/javascript" } } ], "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "POST", "body": { "mode": "raw", "raw": "{\"firstName\": \"Zinedine\", \"lastName\": \"Zidane\", \"email\": \"zz@afi.com\", \"campusId\": \"{{realCId}}\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/professors" } },
						{ "name": "Update", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "PATCH", "body": { "mode": "raw", "raw": "{\"firstName\": \"Zinedine UPD\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/professors/{{tP}}" } },
						{ "name": "Delete", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "DELETE", "url": "{{baseUrl}}/professors/{{tP}}" } }
					]
				}
			]
		},
		{
			"name": "4. REPORTS & IA",
			"item": [
				{ "name": "Create Report", "event": [ { "listen": "test", "script": { "exec": [ "pm.collectionVariables.set(\"tR\", pm.response.json().data.id);" ], "type": "text/javascript" } } ], "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"title\": \"Signalement Urgent\", \"content\": \"Texte de signalement pour test IA\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/reports" } },
				{ "name": "Get Dashboard (ISO)", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/reports?startDate=2024-01-01T00:00:00Z" } },
				{ "name": "Force IA", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "POST", "url": "{{baseUrl}}/reports/{{tR}}/analyze" } }
			]
		}
	],
	"event": [
		{
			"listen": "test",
			"script": { "type": "text/javascript", "exec": [ 
				"pm.test(\"Success Status Code\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
				"pm.test(\"Success Metadata True\", function () { pm.expect(pm.response.json().success).to.be.true; });"
			] }
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
		{ "key": "adminToken", "value": "" },
		{ "key": "realCId", "value": "" },
		{ "key": "tC", "value": "" },
		{ "key": "tL", "value": "" },
		{ "key": "tP", "value": "" },
		{ "key": "tR", "value": "" }
	]
}
