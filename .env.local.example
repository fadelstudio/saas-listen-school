# Copy to `.env.local` (gitignored) and fill values. Overrides `.env` when present.
# Never commit real API keys.

# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://...
JWT_SECRET=change-me-at-least-16-chars

# --- Tenant / multi-école (un seul interrupteur) ---
# true  = prod : sous-domaine + header `x-school-slug` uniquement (404 si aucun tenant).
# false = dev  : en plus path `/<slug>/api/...` puis repli DEFAULT_SCHOOL_SLUG (aligné sur schools.slug).
TENANT_STRICT_MODE=false
DEFAULT_SCHOOL_SLUG=afi-default-school

# --- Email (Resend) ---
# console = log seulement (dev). resend = envoi réel (besoin de RESEND_API_KEY).
MAIL_PROVIDER=console
# Clé Resend (dashboard Resend) — obligatoire si MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Expéditeur vérifié chez Resend (domaine ou onboarding@resend.dev pour tests)
EMAIL_FROM=AFI-LISTEN <onboarding@resend.dev>

# --- OTP inscription (branding email) ---
LOGIN_OTP_ENABLED=false
# Durée (minutes) après laquelle un compte élève non vérifié (OTP jamais validé) est supprimé automatiquement.
PENDING_REGISTRATION_TTL_MINUTES=30
OTP_SITE_NAME=AFI-LISTEN
OTP_EMAIL_SUBJECT=Code de vérification
OTP_HELP_URL=https://example.com/help

# --- App URL (liens reset password, etc.) ---
PUBLIC_APP_URL=http://localhost:3000

# --- Supabase / Redis / IA (reprendre les mêmes clés que ton .env) ---
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJ...
REDIS_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
