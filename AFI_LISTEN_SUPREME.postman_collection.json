{
	"info": {
		"_postman_id": "afi-listen-supreme",
		"name": "AFI-LISTEN SUPREME AUDIT",
		"description": "Collection de test exhaustive : CRUD complet, Scénarios métier, IA & Sécurité.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. AUTH & SETUP",
			"item": [
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json(); pm.collectionVariables.set(\"adminToken\", jsonData.data.token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\"email\": \"admin@afi.com\", \"password\": \"fadeldev\"}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/auth/login"
					}
				},
				{
					"name": "Get Campus ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json(); pm.collectionVariables.set(\"campusId\", jsonData.data[0].id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": "{{baseUrl}}/campuses"
					}
				},
				{
					"name": "Get Level ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json(); pm.collectionVariables.set(\"levelId\", jsonData.data[0].id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": "{{baseUrl}}/levels"
					}
				}
			]
		},
		{
			"name": "2. CRUD CLASSES",
			"item": [
				{
					"name": "Create Class",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json(); pm.collectionVariables.set(\"tempClassId\", jsonData.data.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\"name\": \"TEST CLASS DELETE ME\", \"campusId\": \"{{campusId}}\", \"levelId\": \"{{levelId}}\"}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/classes"
					}
				},
				{
					"name": "Update Class",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"body": {
							"mode": "raw",
							"raw": "{\"name\": \"TEST CLASS UPDATED\"}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/classes/{{tempClassId}}"
					}
				},
				{
					"name": "Delete Class",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"url": "{{baseUrl}}/classes/{{tempClassId}}"
					}
				}
			]
		},
		{
			"name": "3. REPORTS & IA SCENARIO",
			"item": [
				{
					"name": "Create Report (Anonymous)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json(); pm.collectionVariables.set(\"reportId\", jsonData.data.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\"title\": \"Fuite d'eau\", \"content\": \"Il y a une fuite d'eau massive au 3eme étage.\", \"type\": \"PROBLEM_MATERIAL\", \"isAnonymous\": true}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/reports"
					}
				},
				{
					"name": "Filter Reports (Dates & Status)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": "{{baseUrl}}/reports?status=SUBMITTED&startDate=2024-01-01T00:00:00Z"
					}
				},
				{
					"name": "Force AI Analysis",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"url": "{{baseUrl}}/reports/{{reportId}}/analyze"
					}
				}
			]
		},
		{
			"name": "4. CAMPAIGNS",
			"item": [
				{
					"name": "Capture IDs for Campaign",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var resClass = pm.response.json(); pm.collectionVariables.set(\"cClassId\", resClass.data[0].id);",
									"pm.sendRequest({url: pm.collectionVariables.get('baseUrl') + '/academic-modules', method: 'GET', header: { Authorization: 'Bearer ' + pm.collectionVariables.get('adminToken') }}, function (err, res) { pm.collectionVariables.set(\"cModId\", res.json().data[0].id); });",
									"pm.sendRequest({url: pm.collectionVariables.get('baseUrl') + '/professors', method: 'GET', header: { Authorization: 'Bearer ' + pm.collectionVariables.get('adminToken') }}, function (err, res) { pm.collectionVariables.set(\"cProfId\", res.json().data[0].id); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": "{{baseUrl}}/classes"
					}
				},
				{
					"name": "Create Campaign",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\"title\": \"Campaign Supreme\", \"classId\": \"{{cClassId}}\", \"moduleId\": \"{{cModId}}\", \"professorId\": \"{{cProfId}}\"}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/evaluation-campaigns"
					}
				}
			]
		}
	],
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.test(\"Format Standard OK\", function () { var jsonData = pm.response.json(); pm.expect(jsonData).to.have.property('success'); });",
					"if (pm.response.code >= 400) { console.error(\"Erreur detectée:\", pm.response.json()) }"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api/v1",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": ""
		},
		{
			"key": "campusId",
			"value": ""
		},
		{
			"key": "levelId",
			"value": ""
		},
		{
			"key": "tempClassId",
			"value": ""
		},
		{
			"key": "reportId",
			"value": ""
		},
		{
			"key": "cClassId",
			"value": ""
		},
		{
			"key": "cModId",
			"value": ""
		},
		{
			"key": "cProfId",
			"value": ""
		}
	]
}