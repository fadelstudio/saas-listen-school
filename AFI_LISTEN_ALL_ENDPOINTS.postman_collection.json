            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"currentPassword\":\"Student@1234\",\"newPassword\":\"Student@12345\",\"confirmPassword\":\"Student@12345\"}" },
            "url": "{{baseUrl}}/auth/change-password"
          }
        },
        {
          "name": "Refresh Token (Student)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.response.to.have.status(200); var j=pm.response.json(); pm.collectionVariables.set('studentToken', j.data.token); pm.collectionVariables.set('studentRefresh', j.data.refreshToken);" ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{studentRefresh}}\"}" },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Logout (Student)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.response.to.have.status(200);" ] } } ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{studentRefresh}}\"}" },
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Login SuperAdmin",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.response.to.have.status(200); var j=pm.response.json(); pm.collectionVariables.set('superToken', j.data.token);" ] } }
