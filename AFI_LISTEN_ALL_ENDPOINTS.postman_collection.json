  "item": [
    {
      "name": "0. Health + Docs",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "http://localhost:3000/health" }, "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.response.to.have.status(200);" ] } } ] }
      ]
    },
    {
      "name": "1. Auth (Admin + Student + Superadmin)",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.response.to.have.status(200); var j=pm.response.json(); pm.collectionVariables.set('adminToken', j.data.token); pm.collectionVariables.set('adminRefresh', j.data.refreshToken);" ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@afi.com\",\"password\":\"fadeldev\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Register Student",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.response.to.have.status(201); var j=pm.response.json(); pm.collectionVariables.set('studentEmail', j.data.user.email); pm.collectionVariables.set('studentToken', j.data.token); pm.collectionVariables.set('studentRefresh', j.data.refreshToken);" ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"student.{{uniq}}@afi.com\",\"password\":\"Student@1234\",\"firstName\":\"Stu\",\"lastName\":\"Dent\"}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Get Me (Student)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.response.to.have.status(200);" ] } } ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Patch Me (Student)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.response.to.have.status(200);" ] } } ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"firstName\":\"StuUpd\"}" },
            "url": "{{baseUrl}}/auth/me"
          }
        },
