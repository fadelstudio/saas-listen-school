{
  "info": {
    "_postman_id": "afi-listen-all-endpoints",
    "name": "AFI-LISTEN ALL ENDPOINTS (No exemptions)",
    "description": "Covers every endpoint in src/core/routes/v1.ts with a coherent scenario. Includes positive + negative where appropriate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('uniq', Date.now().toString());",
          "pm.collectionVariables.set('nowIso', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Standard envelope present', function () {",
          "  var j = pm.response.json();",
          "  pm.expect(j).to.have.property('success');",
          "  pm.expect(j).to.have.property('message');",
          "  pm.expect(j).to.have.property('data');",
          "  pm.expect(j).to.have.property('error');",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "adminRefresh", "value": "", "type": "string" },
    { "key": "superToken", "value": "", "type": "string" },

    { "key": "studentEmail", "value": "", "type": "string" },
    { "key": "studentToken", "value": "", "type": "string" },
    { "key": "studentRefresh", "value": "", "type": "string" },

    { "key": "campusId", "value": "", "type": "string" },
    { "key": "levelId", "value": "", "type": "string" },
