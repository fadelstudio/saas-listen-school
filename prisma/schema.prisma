// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  AGENT
  STUDENT
  VIEWER
  PROFESSOR
}

enum Sex {
  UNDEFINED
  MALE
  FEMALE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
}

enum EvaluationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DecisionStatus {
  PENDING // Legacy/Fallback status
  PROPOSED // Proposé par l'IA, en attente de validation
  APPROVED // Validé par l'admin, à exécuter
  REJECTED // Rejeté par l'admin
  IN_PROGRESS // En cours d'exécution
  DONE // Terminé
  DEFERRED // Reporté
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum ReportType {
  PROBLEM_MATERIAL
  PROBLEM_ADMIN
  PROBLEM_PEDAGOGICAL
  INCIDENT
  SUGGESTION
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// 5-point rubric for structured evaluations; combined server-side into score /20.
enum RatingBand {
  VERY_POOR
  POOR
  FAIR
  GOOD
  EXCELLENT
}

model School {
  id        String   @id // Manuel: 'afi', 'isi', etc.
  name      String   @unique // e.g. "AFI L'UE"
  slug      String   @unique // e.g. "afi"
  domain    String?  @unique // e.g. "afi-ue.sn"
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses       Campus[]
  users          User[]
  settings       SystemSettings?
  academicLevels AcademicLevel[]
  modules        Module[]

  // Data separation
  reports         Report[]
  evaluations     Evaluation[]
  decisions       Decision[]
  analysisReports AnalysisReport[]
  professors      Professor[]
  notifications   Notification[]
  aiConversations AiConversation[]
  auditLogs       AuditLog[]

  @@map("schools")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model Campus {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @unique
  location  String?
  /// Code court affichable (optionnel)
  code      String?
  /// Téléphone de contact du campus (optionnel)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  classes             Class[]
  users               User[]
  evaluationCampaigns EvaluationCampaign[]
  notifications       Notification[]

  @@map("campuses")
}

model Class {
  id        String   @id @default(uuid())
  name      String // e.g. "L3 Info", "M1 Marketing"
  levelId   String
  campusId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus              Campus               @relation(fields: [campusId], references: [id])
  academicLevel       AcademicLevel        @relation(fields: [levelId], references: [id])
  users               User[]
  reports             Report[]
  evaluations         Evaluation[]
  classModules        ClassModule[]
  evaluationCampaigns EvaluationCampaign[]
  notifications       Notification[]

  @@map("classes")
}

model AcademicLevel {
  id        String   @id @default(uuid())
  schoolId  String
  name      String // e.g. "L1" — unique par école
  order     Int      @default(0) // For display order
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_levels")
}

model Module {
  id        String   @id @default(uuid())
  schoolId  String
  name      String // e.g. "Algorithmique" — unique par école
  code      String? // e.g. "INF-GEN" (optionnel, pas d’unicité globale)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classModules        ClassModule[]
  reports             Report[]
  evaluations         Evaluation[]
  evaluationCampaigns EvaluationCampaign[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("modules")
}

model ClassModule {
  id        String   @id @default(uuid())
  classId   String
  moduleId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class      Class       @relation(fields: [classId], references: [id])
  module     Module      @relation(fields: [moduleId], references: [id])
  professors Professor[] // Professors for THIS specific class instance of the module

  @@unique([classId, moduleId])
  @@map("class_modules")
}

model Professor {
  id         String   @id @default(uuid())
  firstName  String
  lastName   String
  email      String   @unique
  userId     String?  @unique // Link to User if they have login access
  matricule  String?
  /// Numéro interne / identifiant métier (optionnel)
  numero     String?
  phone      String?
  /// Photo de la fiche enseignant (si pas de compte lié, ou en secours du compte User)
  avatarPath String?
  schoolId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school              School?              @relation(fields: [schoolId], references: [id])
  user                User?                @relation(fields: [userId], references: [id])
  modules             ClassModule[] // Linked to specific class assignments
  reports             Report[]
  evaluations         Evaluation[]
  evaluationCampaigns EvaluationCampaign[]

  @@map("professors")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER / AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  /// Null pour les comptes exclusivement Google (connexion sans mot de passe local).
  passwordHash    String?
  /// Identifiant stable Google (`sub` du jeton OIDC). Unique quand renseigné.
  googleId        String?   @unique
  firstName       String
  lastName        String
  matricule       String?   @unique
  /// Numéro interne / dossier (optionnel, distinct du matricule si besoin)
  numero          String?
  phone           String?
  /// Court texte de présentation
  bio             String?   @db.Text
  /// Adresse physique
  address         String?
  /// Chemin fichier dans le bucket Supabase `attachments` (URL signée exposée en API en `avatarUrl`)
  avatarPath      String?
  sex             Sex       @default(UNDEFINED)
  role            Role      @default(STUDENT)
  isActive        Boolean   @default(true)
  fcmToken        String?
  emailVerified   Boolean   @default(true)
  emailVerifiedAt DateTime?

  /// Pour le système de session unique
  currentSessionId String?

  // Relations
  schoolId String?
  classId  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School?    @relation(fields: [schoolId], references: [id])
  campuses  Campus[]
  class     Class?     @relation(fields: [classId], references: [id])
  professor Professor?

  reports             Report[]
  evaluations         Evaluation[]
  decisions           Decision[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  analysisReports     AnalysisReport[]
  passwordResetTokens PasswordResetToken[]
  loginOtpChallenges  LoginOtpChallenge[]
  aiConversations     AiConversation[]
  auditLogs           AuditLog[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String
  userId    String?
  action    String   // e.g., "CREATE_REPORT", "UPDATE_DECISION"
  entity    String   // e.g., "Report", "Decision"
  entityId  String?
  details   Json?    // Données techniques
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  school School  @relation(fields: [schoolId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginOtpChallenge {
  id        String   @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_otp_challenges")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// REPORTS
// ─────────────────────────────────────────────────────────────────────────────

model Report {
  id          String       @id @default(uuid())
  title       String
  content     String
  type        ReportType   @default(OTHER)
  priority    Priority     @default(MEDIUM)
  status      ReportStatus @default(DRAFT)
  isAnonymous Boolean      @default(false)
  category    String?

  // Linkage
  schoolId    String?
  authorId    String?
  classId     String?
  professorId String?
  moduleId    String?

  // Data
  attachments    Json? // Array of URLs/Objects
  deviceMetadata Json? // IP, Device info for anonymous tracking
  aiAnalysis     Json? // Full structured AI result

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school    School?    @relation(fields: [schoolId], references: [id])
  author    User?      @relation(fields: [authorId], references: [id])
  class     Class?     @relation(fields: [classId], references: [id])
  professor Professor? @relation(fields: [professorId], references: [id])
  module    Module?    @relation(fields: [moduleId], references: [id])

  evaluations Evaluation[]
  aiJobs      AiJob[]
  decision    Decision?

  @@map("reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVALUATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Evaluation {
  id          String  @id @default(uuid())
  schoolId    String?
  reportId    String?
  evaluatorId String?
  professorId String
  moduleId    String
  classId     String

  status      EvaluationStatus @default(PENDING)
  isAnonymous Boolean          @default(false)

  /// Final mark /20 — computed when all five RatingBand fields are set.
  score Float?

  comprehensionRating RatingBand?
  explanationRating   RatingBand?
  pedagogyRating      RatingBand?
  availabilityRating  RatingBand?
  rhythmRating        RatingBand?

  comment String?
  aiScore Float? // AI-generated global score

  // Data
  deviceMetadata Json? // IP, Device info for anonymous tracking

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school    School?   @relation(fields: [schoolId], references: [id])
  report    Report?   @relation(fields: [reportId], references: [id])
  evaluator User?     @relation(fields: [evaluatorId], references: [id])
  professor Professor @relation(fields: [professorId], references: [id])
  module    Module    @relation(fields: [moduleId], references: [id])
  class     Class     @relation(fields: [classId], references: [id])

  decision Decision?
  aiJobs   AiJob[]

  // Link to campaign if triggered by one
  campaignId String?
  campaign   EvaluationCampaign? @relation(fields: [campaignId], references: [id])

  @@map("evaluations")
}

// ─────────────────────────────────────────────────────────────────────────────
// DECISIONS
// ─────────────────────────────────────────────────────────────────────────────

model Decision {
  id           String         @id @default(uuid())
  evaluationId String?        @unique
  reportId     String?        @unique
  deciderId    String
  title        String
  rationale    String?
  status       DecisionStatus @default(PROPOSED)
  priority     Priority       @default(MEDIUM)
  responsible  String? // Name or Department
  dueDate      DateTime?

  aiSuggestion String? // AI-generated decision suggestion

  schoolId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school     School?             @relation(fields: [schoolId], references: [id])
  evaluation Evaluation?         @relation(fields: [evaluationId], references: [id])
  report     Report?             @relation(fields: [reportId], references: [id])
  campaignId String?             @unique
  campaign   EvaluationCampaign? @relation(fields: [campaignId], references: [id])

  // Liaison avec une analyse globale
  analysisId String?
  analysis   AnalysisReport? @relation(fields: [analysisId], references: [id])

  decider User    @relation(fields: [deciderId], references: [id])
  aiJobs  AiJob[]

  @@map("decisions")
}

// ─────────────────────────────────────────────────────────────────────────────
// ANALYSIS REPORTS (Global AI Analysis)
// ─────────────────────────────────────────────────────────────────────────────

model AnalysisReport {
  id            String  @id @default(uuid())
  schoolId      String
  title         String
  content       Json // Le contenu du rapport (synthèse, stats, etc.)
  filters       Json // Les filtres utilisés (dateRange, campusId, etc.)
  isRead        Boolean @default(false)
  generatedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School     @relation(fields: [schoolId], references: [id])
  generatedBy User       @relation(fields: [generatedById], references: [id])
  decisions   Decision[]

  @@map("analysis_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI JOBS
// ─────────────────────────────────────────────────────────────────────────────

model AiJob {
  id           String      @id @default(uuid())
  jobType      String // "report-analysis" | "evaluation-scoring" | "decision-suggestion" | "chat-query"
  status       AiJobStatus @default(QUEUED)
  payload      Json
  result       Json?
  errorMessage String?

  reportId     String?
  evaluationId String?
  decisionId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  report     Report?     @relation(fields: [reportId], references: [id])
  evaluation Evaluation? @relation(fields: [evaluationId], references: [id])
  decision   Decision?   @relation(fields: [decisionId], references: [id])

  @@map("ai_jobs")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI CHAT HISTORY
// ─────────────────────────────────────────────────────────────────────────────

model AiConversation {
  id        String      @id @default(uuid())
  schoolId  String
  userId    String
  title     String
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// SYSTEM CONFIGURATION (SaaS Ready)
// ─────────────────────────────────────────────────────────────────────────────

model SystemSettings {
  id         String @id @default(uuid())
  schoolId   String @unique
  schoolName String @default("AFI")

  // Auth Toggles
  authReportsRequired     Boolean @default(false)
  authEvaluationsRequired Boolean @default(false)
  authOtpRequired         Boolean @default(false)

  // AI Dynamic Config
  aiEnabled          Boolean @default(true)
  aiConfigs          Json    @default("[]") // Array of { id, name, provider, model, apiKey, priority, isFree }
  aiOverrideConfigId String? // If set, force this model (manual override)

  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@map("system_settings")
}

model Notification {
  id      String @id @default(uuid())
  title   String
  message String
  type    String // "AI_FAILURE" | "EVALUATION_CAMPAIGN" | "EVALUATION_CAMPAIGN_REMINDER" | "SYSTEM" | "BROADCAST"

  // Targeting (Legacy / Personal)
  userId String? // Adressée directement à un utilisateur spécifique

  // Targeting (Broadcast / Flex) - Nouveaux champs pour ciblage multiple
  targetRoles     Role[]   @default([])
  targetCampusIds String[] @default([])
  targetClassIds  String[] @default([])
  targetUserIds   String[] @default([]) // Pour ciblage de plusieurs personnes sans créer N notifications

  // Legacy fields (kept for compatibility or simpler single-target)
  targetRole     Role? // Targeted role (deprecated in favor of targetRoles?)
  targetCampusId String? // Targeted campus
  targetClassId  String? // Targeted class

  // Content enrichment
  url         String? // Optional link
  attachments Json? // Array of { name, url, type }

  campaignId String? // Optional linkage (reminders, campaign created)
  /// Isolation multi-tenant : schoolId null = broadcast SuperAdmin (toutes écoles)
  schoolId   String?
  isRead     Boolean @default(false)

  /// UTI = Unique Tracking Identifier (device UUID) — pour cibler les invités sans compte
  /// Stocké par l'app mobile/web lors d'une soumission anonyme.
  targetDeviceUti String?

  createdAt DateTime @default(now())

  user     User?               @relation(fields: [userId], references: [id])
  school   School?             @relation(fields: [schoolId], references: [id])
  campus   Campus?             @relation(fields: [targetCampusId], references: [id])
  class    Class?              @relation(fields: [targetClassId], references: [id])
  campaign EvaluationCampaign? @relation(fields: [campaignId], references: [id])

  @@unique([userId, campaignId, type])
  @@index([userId, isRead, createdAt])
  @@index([schoolId, isRead, createdAt])
  @@index([campaignId, createdAt])
  @@index([targetCampusId])
  @@index([targetClassId])
  @@index([targetDeviceUti, createdAt])
  @@map("notifications")
}

model GuestDevice {
  uti       String   @id
  fcmToken  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guest_devices")
}


model EvaluationCampaign {
  id          String   @id @default(uuid())
  title       String
  description String?
  scope       String   @default("CLASS") // CLASS | CAMPUS | SCHOOL
  classId     String?
  campusId    String?
  moduleId    String?
  professorId String?
  status      String   @default("DRAFT") // DRAFT, ACTIVE, COMPLETED
  dueDate     DateTime // end date (deadline)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class         Class?         @relation(fields: [classId], references: [id])
  campus        Campus?        @relation(fields: [campusId], references: [id])
  module        Module?        @relation(fields: [moduleId], references: [id])
  professor     Professor?     @relation(fields: [professorId], references: [id])
  evaluations   Evaluation[]
  notifications Notification[]
  decision      Decision?

  @@index([scope, status, dueDate])
  @@index([campusId, status, dueDate])
  @@index([classId, status, dueDate])
  @@map("evaluation_campaigns")
}
